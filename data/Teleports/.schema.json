{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": ["destinations", "gatekeepers"],
    "properties": {
        "destinations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "locX", "locY", "locZ", "price"],
                "properties": {
                    "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "locX": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
                    "locY": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
                    "locZ": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
                    "price": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                }
            }
        },
        "gatekeepers": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["npcId", "routes"],
                "properties": {
                    "npcId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "routes": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["destinationId", "label"],
                            "properties": {
                                "destinationId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                                "label": { "type": "string" }
                            }
                        }
                    }
                }
            }
        }
    }
}
