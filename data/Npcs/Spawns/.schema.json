{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "selfId": {
                "type": "string"
            },
            "bounds": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "locX": {
                            "type": "integer"
                        },
                        "locY": {
                            "type": "integer"
                        },
                        "minZ": {
                            "type": "integer"
                        },
                        "maxZ": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "locX",
                        "locY",
                        "minZ",
                        "maxZ"
                    ]
                }
            },
            "spawnAnchors": {
                "description": "Authored player-accessible entry points for random spawn connectivity; never inferred from monster coordinates.",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "locX": { "type": "integer" },
                        "locY": { "type": "integer" },
                        "locZ": { "type": "integer" }
                    },
                    "required": ["locX", "locY", "locZ"]
                }
            },
            "spawns": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "selfId": {
                            "type": "integer"
                        },
                        "name": {
                            "type": "string"
                        },
                        "coords": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "locX": {
                                        "type": "integer"
                                    },
                                    "locY": {
                                        "type": "integer"
                                    },
                                    "locZ": {
                                        "type": "integer"
                                    },
                                    "head": {
                                        "type": "integer"
                                    }
                                },
                                "required": [
                                    "locX",
                                    "locY",
                                    "locZ",
                                    "head"
                                ]
                            }
                        },
                        "total": {
                            "type": "integer"
                        },
                        "respawn": {
                            "type": "integer"
                        },
                        "bias": {
                            "type": "integer"
                        },
                        "period": {
                            "type": "string",
                            "enum": ["always", "day", "night"]
                        }
                    },
                    "required": [
                        "selfId",
                        "name",
                        "coords",
                        "total",
                        "respawn",
                        "bias"
                    ]
                }
            }
        },
        "required": [
            "selfId",
            "bounds",
            "spawns"
        ]
    }
}
